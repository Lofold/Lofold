# Нормализация переводов строк: в репо всегда LF.
# Исключение — Windows-скрипты (.bat/.cmd/.ps1), они в CRLF.

* text=auto eol=lf

# Windows-скрипты
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Бинарные файлы — не конвертировать
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.exe   binary
*.dll   binary
